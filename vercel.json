{
    "version": 2,
    "framework": null,
    "installCommand": "npm install --ignore-scripts=false",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/storage/(.*)",
            "dest": "/storage/app/public/$1"
        },
        {
            "src": "/files/(.*)",
            "dest": "/public/files/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Portofolio Desain Interior",
        "APP_KEY": "base64:OdoP653jv436/JSfcIXEXhgApJdyv4mi6SR69qohiFc=",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/bootstrap/cache/config.php",
        "APP_EVENTS_CACHE": "/tmp/bootstrap/cache/events.php",
        "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
        "APP_ROUTES_CACHE": "/tmp/bootstrap/cache/routes.php",
        "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "CACHE_STORE": "file",
        "CACHE_DIRECTORY": "/tmp/storage/framework/cache/data",
        "SESSION_DRIVER": "cookie",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": "/tmp/database.sqlite"
    }
}
